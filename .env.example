# ============================================================
# Arellan Platform v2.0 — Environment Configuration
# ============================================================

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_VERSION=2.0.0

# ─── Base de Datos ────────────────────────────────────────────
DATABASE_URL=postgresql://arellan:arellan_dev_2026@localhost:5432/arellan_db?schema=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── MFA (Two-Factor Authentication) ──────────────────────────
MFA_ISSUER=ArellanHnos

# ─── Anti-Fraud Security ──────────────────────────────────────
INTEGRITY_HASH_SECRET=change-me-to-a-unique-cryptographic-secret-64-chars
BCRYPT_ROUNDS=12

# ─── Frontend URLs ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://localhost:3002

# ─── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─── Observability ────────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

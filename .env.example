# ============================================================
# Arellan Platform v2.0 — Environment Configuration
# ============================================================

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_VERSION=2.0.0

# ─── Base de Datos ────────────────────────────────────────────
DATABASE_URL=postgresql://arellan:arellan_dev_2026@localhost:5432/arellan_db?schema=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── MFA (Two-Factor Authentication) ──────────────────────────
MFA_ISSUER=ArellanHnos

# ─── Anti-Fraud Security ──────────────────────────────────────
INTEGRITY_HASH_SECRET=change-me-to-a-unique-cryptographic-secret-64-chars
BCRYPT_ROUNDS=12

# ─── Frontend URLs ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007

# ─── IoT Bridge (arellan-hardware-iot) ────────────────────────
# Secreto compartido para /api/v1/public/iot/* (ZKTeco ADMS, ONVIF cameras)
# y para las llamadas salientes platform -> bridge (header x-device-key)
IOT_BRIDGE_SHARED_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
IOT_BRIDGE_URL=http://localhost:3007
# Camara ONVIF de bahia usada por defecto en POST /orders/:id/photos/camera-capture
ONVIF_DEFAULT_CAMERA_ID=CAM-BAHIA-01

# ─── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─── Observability ────────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
